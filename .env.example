# Salin file ini jadi .env lalu isi API key.
OPENAI_API_KEY=
# Model untuk scoring & penulisan naskah (sama seperti engine lama)
OPENAI_MODEL=gpt-5.6
# Hanya dipakai bila pilih "OpenAI image" sebagai sumber gambar
OPENAI_IMAGE_MODEL=gpt-image-1
# Opsional (low / medium / high) bila model mendukung
OPENAI_REASONING_EFFORT=
